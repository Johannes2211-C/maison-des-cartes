# ── Maison des Cartes : copiez ce fichier en .env et complétez ──
NODE_ENV=development            # production en ligne
PORT=3000
PUBLIC_URL=http://localhost:3000

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_ENV=sandbox              # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=           # reste sur le serveur, jamais envoyé au navigateur
PAYPAL_WEBHOOK_ID=              # optionnel mais recommandé (événements PAYMENT.CAPTURE.*)

# Livraison des codes
DELIVERY_MODE=manual            # manual : l'équipe remet les codes | inventory : codes importés et chiffrés
CODES_ENCRYPTION_KEY=           # obligatoire : openssl rand -base64 32
RESERVATION_MINUTES=30

# E-mails transactionnels (resend | brevo | none)
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Maison des Cartes
MERCHANT_EMAIL=

# Administration (API /api/admin/*) : openssl rand -hex 32
ADMIN_TOKEN=

# Visuels : en développement, les produits sans visuel authentique s'affichent avec un
# visuel provisoire clairement signalé. Toujours false (défaut) en production.
# ALLOW_MISSING_IMAGES=false
MAX_ORDER_EUR=1000
